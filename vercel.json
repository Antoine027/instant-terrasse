{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo skip",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "regions": [
    "cdg1"
  ],
  "git": {
    "deploymentEnabled": {
      "travail": false
    }
  },
  "redirects": [
    {
      "source": "/actualites/",
      "destination": "/nos-terrasses/",
      "statusCode": 301
    },
    {
      "source": "/comment-amenager-son-balcon/",
      "destination": "/terrasse-balcon-lyon/",
      "statusCode": 301
    },
    {
      "source": "/terrasse-caluire-et-cuire/",
      "destination": "/terrasse-lyon/",
      "statusCode": 301
    },
    {
      "source": "/nosterrasses/",
      "destination": "/nos-terrasses/",
      "statusCode": 301
    },
    {
      "source": "/comment-choisir-sa-terrasse/",
      "destination": "/nos-terrasses/",
      "statusCode": 301
    },
    {
      "source": "/prix-terrasse-lyon/",
      "destination": "/nos-terrasses/",
      "statusCode": 301
    },
    {
      "source": "/la-terrasse-aluminium/",
      "destination": "/terrasse-aluminium-lyon/",
      "statusCode": 301
    },
    {
      "source": "/terrasse-aluminium/",
      "destination": "/terrasse-aluminium-lyon/",
      "statusCode": 301
    },
    {
      "source": "/terrasse-composite/",
      "destination": "/terrasse-composite-lyon/",
      "statusCode": 301
    },
    {
      "source": "/form/:slug*",
      "destination": "/contact/",
      "statusCode": 301
    },
    {
      "source": "/politique-de-cookies-ue/",
      "destination": "/confidentialite/",
      "statusCode": 301
    },
    {
      "source": "/terrasses-a-lyon-conception-et-pose/",
      "destination": "/terrasse-lyon/",
      "statusCode": 301
    },
    {
      "source": "/terrasse-bois/",
      "destination": "/terrasse-bois-lyon/",
      "statusCode": 301
    },
    {
      "source": "/terrasse-carrelage/",
      "destination": "/terrasse-carrelage-lyon/",
      "statusCode": 301
    },
    {
      "source": "/category/bois/",
      "destination": "/terrasse-bois-lyon/",
      "statusCode": 301
    },
    {
      "source": "/category/aluminium/",
      "destination": "/terrasse-aluminium-lyon/",
      "statusCode": 301
    },
    {
      "source": "/category/composite/",
      "destination": "/terrasse-composite-lyon/",
      "statusCode": 301
    },
    {
      "source": "/category/carrelage/",
      "destination": "/terrasse-carrelage-lyon/",
      "statusCode": 301
    },
    {
      "source": "/category/entretien/",
      "destination": "/terrasse-bois-lyon/",
      "statusCode": 301
    },
    {
      "source": "/category/terrasse/",
      "destination": "/nos-terrasses/",
      "statusCode": 301
    },
    {
      "source": "/category/:slug*",
      "destination": "/nos-terrasses/",
      "statusCode": 301
    },
    {
      "source": "/pergola-toile-tendue-lyon/",
      "destination": "/pergola-toit-fixe-lyon/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
